.DS_Store
node_modules/
.venv/
__pycache__/
*.py[cod]
*.log
.env
.env.*
!.env.example
coverage/
outputs/*
/output/
/.playwright-cli/
# Intermediate collaboration experiments stay local. CI produces fresh release
# evidence and publishes its selected report as an Actions artifact.
/work/validation/collab/*
!/work/validation/collab/README.md
!/work/validation/collab/release-bin-physical.json
# Local design-direction calibration cache is not part of the release evidence.
/.impeccable/questions/
# Keep final source-bound G1 evidence; intermediate probes are reproducible
# local development output, not release acceptance records.
work/validation/g1/*
!work/validation/g1/final-single.jsonl
!work/validation/g1/final-repeat.jsonl
!work/validation/g1/opening-safety-final.json
!work/validation/g1/finger-limit-physics-kv20.json
!work/validation/g1/photo-camera-material-check.json
!work/validation/g1/final-acceptance.json
!work/validation/g1/ui-browser-availability.json
!work/validation/g1/PHOTO-VISUAL-CHANGES.md
# Publish only the current, source-bound C5 release evidence. Keep earlier
# development probes locally without presenting them as release acceptance.
work/validation/c5/*
!work/validation/c5/grasp-release-1x.jsonl
!work/validation/c5/grasp-release-3x.jsonl
!work/validation/c5/opening-release.json
!work/validation/c5/manual-motion-final.json
!work/validation/c5/physics-current.json
!work/validation/c5/visuals-final.json
!work/validation/c5/ui-static-final.json
!work/validation/c5/browser-final.json
!work/validation/c5/final-acceptance.json
!work/validation/c5/design-detector.json
!work/validation/c5/finish-review.md
work/validation/multi/*
!work/validation/multi/coordinator-final.json
!work/validation/multi/physical-final.json
!work/validation/multi/pages-final.json
!work/validation/multi/ui-static-final.json
!work/validation/multi/browser-final.json
!work/validation/multi/final-acceptance.json
!work/validation/multi/design-detector.json
!work/validation/multi/finish-review.md
!work/validation/multi/r1-gripper-final.json
!work/validation/multi/stack-final.json
!work/validation/multi/verifier-checks-final.json
# Pipe-task release evidence only; leave failed/quick tuning probes local.
work/validation/multi-pipes/*
!work/validation/multi-pipes/physical-final.json
!work/validation/multi-pipes/ui-final.json
!work/validation/multi-pipes/browser-final.json
!work/validation/multi-pipes/acceptance-final.json
!work/validation/multi-pipes/verifier-final.json
!work/validation/multi-pipes/design-detector.json
!work/validation/multi-pipes/finish-review.md
