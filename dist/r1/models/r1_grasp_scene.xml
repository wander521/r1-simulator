                <body name="left_arm_link2" pos=".12 .106 0"><joint name="left_arm_joint2" type="hinge" axis="0 0 -1" range="0 3.2289"/><geom type="capsule" fromto="0 0 0 .35 0 0" size=".045" mass="1.3"/>
