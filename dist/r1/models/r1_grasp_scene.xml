<!--
  Collision-oriented MJCF derived from r1_v2_1_0.urdf.
  Render meshes remain in the browser URDF view; the capsules/boxes below are
  intentionally simple convex collision proxies, which makes stable gripping
  possible in the WebAssembly MuJoCo runtime.
-->
<mujoco model="galaxea_r1_grasp">
  <compiler angle="radian" meshdir="../assets/meshes"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <size nconmax="96" njmax="256"/>
  <default>
    <joint damping="2" armature="0.015" limited="true"/>
    <!-- Robot meshes are visual-only in this collision scene.  The four mocap
         pads below are driven directly from the rendered URDF fingertips, so
         they are the only robot surfaces allowed to touch task objects. -->
    <geom friction="1.6 0.03 0.001" solref="0.004 1" solimp=".92 .98 .001" contype="0" conaffinity="0"/>
    <position kp="110" forcelimited="true" forcerange="-70 70"/>
  </default>
  <asset>
    <mesh name="r1_base_mesh" file="base_link.STL"/>
    <mesh name="r1_torso_mesh" file="torso_link4.STL"/>
