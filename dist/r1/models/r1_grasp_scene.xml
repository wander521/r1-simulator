                <body name="right_arm_link2" pos=".12 -.106 0"><joint name="right_arm_joint2" type="hinge" axis="0 0 1" range="0 3.2289"/><geom type="capsule" fromto="0 0 0 .35 0 0" size=".045" mass="1.3"/>
                  <body name="right_arm_link3" pos=".35 -.02 0"><joint name="right_arm_joint3" type="hinge" axis="0 0 1" range="-3.3161 0"/><geom type="capsule" fromto="0 0 0 .21 0 0" size=".04" mass=".82"/>
                    <body name="right_arm_link4" pos=".21 -.07 0"><joint name="right_arm_joint4" type="hinge" axis="1 0 0" range="-2.8798 2.8798"/><geom type="capsule" fromto="0 0 0 .12 0 0" size=".035" mass=".7"/>
                      <body name="right_arm_link5" pos=".12 0 0"><joint name="right_arm_joint5" type="hinge" axis="0 -1 0" range="-1.6581 1.6581"/><geom type="capsule" fromto="0 0 0 .10 0 0" size=".03" mass=".42"/>
                        <body name="right_arm_link6" pos=".10 0 0"><joint name="right_arm_joint6" type="hinge" axis="1 0 0" range="-2.8798 2.8798"/><geom type="sphere" size=".035" mass=".09"/>
                          <body name="right_gripper" pos=".104 0 0"><geom type="mesh" mesh="r1_right_gripper_mesh" contype="0" conaffinity="0"/><geom type="box" pos=".02 0 0" size=".045 .032 .025" rgba=".82 .88 1 1" mass=".6"/>
                            <body name="gripper_left" pos=".037 -.014 0"><joint name="right_gripper_finger_joint1" type="slide" axis="0 -1 0" range="0 .05"/><geom type="mesh" mesh="r1_right_finger_a_mesh" contype="0" conaffinity="0"/><geom name="right_finger_a_collision" type="box" pos=".020 0 0" size=".028 .006 .013" mass=".027"/></body>
                            <body name="gripper_right" pos=".037 .014 0"><joint name="right_gripper_finger_joint2" type="slide" axis="0 1 0" range="0 .05"/><geom type="mesh" mesh="r1_right_finger_b_mesh" contype="0" conaffinity="0"/><geom name="right_finger_b_collision" type="box" pos=".020 0 0" size=".028 .006 .013" mass=".027"/></body>
