    <camera name="overhead_rgb" pos="1.42 0 1.75" xyaxes="0 1 0 -.70 .70 0"/>
    <geom name="floor" type="plane" size="3 3 .1" rgba=".03 .08 .12 1" contype="1" conaffinity="1"/>
    <!-- Exact conversion of the browser workcell: Three(x,y,z) -> MuJoCo(x,-z,y). -->
    <body name="task_table" pos=".78 0 .6475">
      <geom name="table_top" type="box" size=".36 .38 .0325" material="table" contype="1" conaffinity="1"/>
      <geom type="box" pos="-.28 -.29 -.365" size=".0225 .0225 .325" material="table" contype="1" conaffinity="1"/><geom type="box" pos="-.28 .29 -.365" size=".0225 .0225 .325" material="table" contype="1" conaffinity="1"/>
      <geom type="box" pos=".28 -.29 -.365" size=".0225 .0225 .325" material="table" contype="1" conaffinity="1"/><geom type="box" pos=".28 .29 -.365" size=".0225 .0225 .325" material="table" contype="1" conaffinity="1"/>
    </body>
    <!-- Three colour-specific bins, matching the browser view.  They are visual-only so a released item rests on the tabletop. -->
    <geom name="red_zone" type="box" pos=".78 -.12 .6835" size=".052 .052 .001" material="red" contype="0" conaffinity="0"/>
    <geom name="blue_zone" type="box" pos=".78 0 .6835" size=".052 .052 .001" material="blue" contype="0" conaffinity="0"/>
    <geom name="yellow_zone" type="box" pos=".78 .12 .6835" size=".052 .052 .001" material="yellow" contype="0" conaffinity="0"/>
