          <body name="torso_link3" pos="0 0 .3"><joint name="torso_joint3" type="hinge" axis="0 -1 0" range="-1.8326 1.5708"/><geom type="capsule" fromto="0 0 0 0 0 .1" size=".10" mass="2.1"/>
