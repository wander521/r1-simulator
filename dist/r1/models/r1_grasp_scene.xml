    <body name="blue_block" pos=".78 0 .7015"><freejoint/><geom name="blue_block_geom" type="box" size=".026 .016 .019" mass=".050" material="blue" contype="1" conaffinity="1"/></body>
    <body name="yellow_cylinder" pos=".78 .12 .7085"><freejoint/><geom name="yellow_cylinder_geom" type="cylinder" size=".020 .026" mass=".042" material="yellow" contype="1" conaffinity="1"/></body>
    <!-- Kinematic contact pads; their mocap transforms are updated each frame
         from the visible URDF finger links. -->
    <body name="right_finger_a_pad" mocap="true"><geom type="sphere" size=".042" rgba=".2 .95 1 .16" contype="2" conaffinity="1"/></body>
    <body name="right_finger_b_pad" mocap="true"><geom type="sphere" size=".042" rgba=".2 .95 1 .16" contype="2" conaffinity="1"/></body>
    <body name="left_finger_a_pad" mocap="true"><geom type="sphere" size=".042" rgba=".2 .95 1 .16" contype="2" conaffinity="1"/></body>
    <body name="left_finger_b_pad" mocap="true"><geom type="sphere" size=".042" rgba=".2 .95 1 .16" contype="2" conaffinity="1"/></body>
