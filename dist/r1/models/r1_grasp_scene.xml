    <mesh name="r1_right_finger_a_mesh" file="right_gripper_finger_link1.STL"/>
    <mesh name="r1_right_finger_b_mesh" file="right_gripper_finger_link2.STL"/>
    <material name="table" rgba=".18 .32 .40 1"/>
    <material name="red" rgba=".92 .08 .06 1"/><material name="blue" rgba=".03 .42 .94 1"/><material name="yellow" rgba="1 .72 .04 1"/>
