{
  "name": "r1-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Local Galaxea R1 dual-arm grasping simulation with Three.js and MuJoCo",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "test": "node work/test-r1-dynamics.mjs && node work/test-r1-dynamic-grasp.mjs",
    "test:repeat": "node work/test-r1-dynamic-grasp.mjs --repeat=3",
    "test:legacy": "node work/test-r1-grasp.mjs",
    "build:physics": "node work/build-r1-dynamics.mjs"
  }
}
